{
  "id": "/",
  "name": "S-Chat",
  "short_name": "S-Chat",
  "description": "Fast one-to-one messaging with a personal chat link, statuses and calls.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#140f8f",
  "theme_color": "#140f8f",
  "categories": ["social", "communication"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chats", "url": "/app", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Status", "url": "/app/status", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calls", "url": "/app/calls", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
