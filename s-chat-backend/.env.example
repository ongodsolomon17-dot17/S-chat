# Copy to .env for local development only. On Render, set these in the dashboard
# (Environment tab). NEVER commit real values.

PORT=8080

# ---- PRIMARY database: Supabase Postgres (your existing data) ----------------------------
# Supabase dashboard > Project Settings > Database > Connection string > JDBC / Transaction pooler (port 6543).
# jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require   (user is usually postgres.<project-ref>)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Optional but recommended: direct/session host, used ONLY by Flyway migrations (port 5432).
SUPABASE_DB_DIRECT_URL=

# ---- FALLBACK database: Neon Postgres (read-only copy kept in sync by logical replication) ----
# Leave NEON_DB_URL empty to run on Supabase only. Setup: docs/DATABASE_FAILOVER.md
# Use the POOLED host (contains "-pooler"):
NEON_DB_URL=jdbc:postgresql://ep-your-endpoint-pooler.your-region.aws.neon.tech/neondb?sslmode=require
NEON_DB_USER=
NEON_DB_PASSWORD=
# true  = the fallback rejects writes (safe; recommended). false = writes allowed on Neon => data can DIVERGE.
DB_FALLBACK_READ_ONLY=true
DB_PRIMARY_TIMEOUT_MS=4000
DB_PROBE_INTERVAL_SECONDS=10
DB_POOL_SIZE=8
JPA_DDL_AUTO=update

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48   (must be at least 32 bytes)
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ---- URLs -----------------------------------------------------------------
# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
FRONTEND_ORIGINS=http://localhost:5173
# Public URL of the frontend; used for shareable chat links
PUBLIC_BASE_URL=http://localhost:5173

# ---- Legal document versions (bump when the documents change) --------------
TERMS_VERSION=2026-11-19
PRIVACY_VERSION=2026-11-19

# ---- Chat -------------------------------------------------------------------
MESSAGE_EDIT_WINDOW_MIN=15

# ---- File storage (Supabase Storage; database is Neon) -----------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=s-chat-media

# ---- Optional integrations (leave blank to disable) -------------------------
APP_NAME=S-Chat
# ---- Account recovery (each channel turns on only when its values are set) ----
# EMAIL (easiest): resend.com -> API Keys. Testing without a domain: RESEND_FROM_ADDRESS=onboarding@resend.dev
#   (Resend then delivers ONLY to your own Resend-account email). For real users, verify your domain in Resend.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=S-Chat <no-reply@yourdomain.com>
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp via Twilio (sandbox number for testing, approved sender + template for production)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=
RECOVERY_CODE_TTL_MIN=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
