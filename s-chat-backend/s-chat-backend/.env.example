# Copy to .env for local dev only. On Render, set these in the dashboard's
# Environment tab instead — never commit real secrets to git.

PORT=8080

# Supabase Postgres (use the connection pooler URL, port 6543, for Render)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Your deployed Vercel URL(s), comma-separated, no trailing slash
FRONTEND_ORIGINS=https://your-app.vercel.app

# Resend (transactional email / feedback)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=S-Chat <no-reply@yourdomain.com>

JPA_DDL_AUTO=update
